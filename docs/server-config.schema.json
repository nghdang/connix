{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Connix Client Configuration",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "transport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "enum": [
                        "TCP",
                        "UDP",
                        "UDS"
                    ]
                },
                "address": {
                    "type": "string",
                    "minLength": 1
                },
                "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "STREAM",
                        "DATAGRAM"
                    ]
                }
            },
            "required": [
                "type",
                "address"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "enum": [
                                    "TCP",
                                    "UDP"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "port"
                        ],
                        "not": {
                            "required": [
                                "mode"
                            ]
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "UDS"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "mode"
                        ],
                        "not": {
                            "required": [
                                "port"
                            ]
                        }
                    }
                }
            ]
        },
        "connection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "max_connections": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "buffer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "send_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "receive_size": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
    },
    "required": [
        "transport"
    ]
}
