@startuml SERVER Connection Cycle
actor Trigger
participant "Network peer" as peer

box "Use Cases"
participant "Execution scheduler" as scheduler
participant "Connection-cycle use case" as cycle
end box

box "Interface Adapters"
participant "Protocol gateway" as gateway
participant "Observation port" as output
end box

Trigger -> scheduler : eligible SERVER trigger
scheduler -> cycle : start SERVER cycle
cycle -> gateway : accept (5 s)
gateway -> peer : await connection
peer --> gateway : accepted
gateway --> cycle : connected
cycle -> output : accept event
cycle -> gateway : receive (10 s)
gateway -> peer : await message
peer --> gateway : message
gateway --> cycle : received
cycle -> gateway : send (5 s)
gateway -> peer : response
peer --> gateway : send complete
gateway --> cycle : sent
cycle -> output : traffic events
cycle -> gateway : close
gateway -> peer : close
cycle -> output : close event
cycle --> scheduler : cycle complete
@enduml
