{
    "name": "Test full workflow",
    "nodes": {
        "user-tcp-server": {
            "type": "USER",
            "transport": "TCP",
            "endpoint": {
                "address": "127.0.0.1",
                "port": 12345
            },
            "frame": {
                "type": "FIXED_SIZE",
                "size": 4
            }
        },
        "test-tcp-server": {
            "type": "SERVER",
            "transport": "TCP",
            "endpoint": {
                "address": "127.0.0.1",
                "port": 56789
            },
            "frame": {
                "type": "FIXED_SIZE",
                "size": 4
            },
            "maxConnections": 20,
            "bufferSize": 4096,
            "onReceived": [
                {
                    "patterns": ["12 34 56 78"],
                    "offset": 0,
                    "actions": ["respond"]
                }
            ]
        },
        "test-udp-server": {
            "type": "SERVER",
            "transport": "UDP",
            "endpoint": {
                "address": "127.0.0.1",
                "port": 12356
            },
            "onReceived": [
                {
                    "patterns": ["12 34 56 78"],
                    "offset": 0,
                    "actions": ["respond"]
                }
            ]
        },
        "test-uds-server": {
            "type": "SERVER",
            "transport": "UDS_STREAM",
            "endpoint": {
                "address": "/tmp/test-uds-server.sock"
            },
            "frame": {
                "type": "LENGTH_PREFIX",
                "lengthOffset": 0,
                "lengthSize": 2,
                "byteOrder": "BIG_ENDIAN"
            },
            "onReceived": [
                {
                    "patterns": ["12 34 56 78"],
                    "offset": 2,
                    "actions": ["respond"]
                }
            ]
        },
        "test-uds-datagram-server": {
            "type": "SERVER",
            "transport": "UDS_DATAGRAM",
            "endpoint": {
                "address": "/tmp/test-uds-datagram-server.sock"
            },
            "onReceived": [
                {
                    "patterns": ["12 34 56 78"],
                    "offset": 0,
                    "actions": ["respond"]
                }
            ]
        },
        "test-uds-datagram-client": {
            "type": "CLIENT",
            "transport": "UDS_DATAGRAM",
            "bufferSize": 2048,
            "onReceived": [
                {
                    "patterns": ["12 34 56 78"],
                    "offset": 0,
                    "actions": ["send-uds-datagram"]
                }
            ]
        },
        "test-tcp-client": {
            "type": "CLIENT",
            "transport": "TCP",
            "connectionTimeout": 5000,
            "idleTimeout": 30000,
            "frame": {
                "type": "FIXED_SIZE",
                "size": 4
            },
            "bufferSize": 1024,
            "onReceived": [
                {
                    "patterns": ["12 34 56 78"],
                    "offset": 0,
                    "actions": ["send-tcp"]
                }
            ]
        },
        "test-udp-client": {
            "type": "CLIENT",
            "transport": "UDP",
            "connectionTimeout": 5000,
            "bufferSize": 4096,
            "onReceived": [
                {
                    "patterns": ["12 34 56 78"],
                    "offset": 0,
                    "actions": ["send-udp"]
                }
            ]
        },
        "test-uds-client": {
            "type": "CLIENT",
            "transport": "UDS_STREAM",
            "connectionTimeout": 5000,
            "idleTimeout": 30000,
            "frame": {
                "type": "LENGTH_PREFIX",
                "lengthOffset": 0,
                "lengthSize": 2,
                "byteOrder": "BIG_ENDIAN"
            },
            "bufferSize": 2048,
            "onReceived": [
                {
                    "patterns": ["12 34 56 78"],
                    "offset": 2,
                    "actions": ["send-uds"]
                }
            ]
        }
    },
    "timers": {
        "timer-1000": {
            "interval": 1000,
            "singleShot": false,
            "onTimeout": [
                "send-test-data",
                "send-tcp",
                "send-uds-datagram"
            ]
        }
    },
    "filesystems": {
        "test-uds-data": {
            "path": "/tmp/test-uds-data.bin",
            "debounce": 100,
            "onModified": [
                "send-uds"
            ]
        },
        "test-udp-data": {
            "path": "/tmp/test-udp-event",
            "debounce": 100,
            "onModified": [
                "send-uds",
                "send-udp"
            ]
        }
    },
    "actions": {
        "respond": {
            "type": "RESPOND",
            "payload": {
                "type": "BYTES",
                "source": "12 34 56 78"
            }
        },
        "send-test-data": {
            "type": "SEND",
            "sourceNode": "test-tcp-client",
            "targetNode": "user-tcp-server",
            "executionDelay": 10,
            "executionTimeout": 5000,
            "maxPending": 100,
            "payload": {
                "type": "BYTES",
                "source": "12 34 56 78"
            }
        },
        "send-tcp": {
            "type": "SEND",
            "sourceNode": "test-tcp-client",
            "targetNode": "test-tcp-server",
            "executionDelay": 0,
            "payload": {
                "type": "BYTES",
                "source": "12 34 56 78"
            }
        },
        "send-udp": {
            "type": "SEND",
            "sourceNode": "test-udp-client",
            "targetNode": "test-udp-server",
            "executionDelay": 0,
            "payload": {
                "type": "FILE",
                "source": "/tmp/test-udp-data.bin"
            }
        },
        "send-uds": {
            "type": "SEND",
            "sourceNode": "test-uds-client",
            "targetNode": "test-uds-server",
            "payload": {
                "type": "FILE",
                "source": "/tmp/test-uds-data.bin"
            }
        },
        "send-uds-datagram": {
            "type": "SEND",
            "sourceNode": "test-uds-datagram-client",
            "targetNode": "test-uds-datagram-server",
            "payload": {
                "type": "BYTES",
                "source": "12 34 56 78"
            }
        }
    }
}
